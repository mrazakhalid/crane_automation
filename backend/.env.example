# Copy to .env and adjust. NEVER commit the real .env.
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Storage driver — THE web/offline switch:
#   mongo  → web deployment (default)
#   sqlite → offline desktop build (the Electron app sets this for you)
# Only the selected driver is loaded, so a web install never needs the SQLite
# native module and the offline build never needs MongoDB.
STORAGE_DRIVER=mongo

# MongoDB (used when STORAGE_DRIVER=mongo). Leave MONGODB_URI empty in dev/test
# to auto-start an in-memory MongoDB (zero setup). In production this is
# REQUIRED, e.g. mongodb://localhost:27017 or a MongoDB Atlas SRV URI.
MONGODB_URI=
MONGODB_DB=crane_automation

# SQLite (used when STORAGE_DRIVER=sqlite). File path for the DB; empty →
# data/crane.db under the cwd. Use ':memory:' for throwaway/testing.
SQLITE_PATH=

# When set, the API also serves the built frontend (SPA) from this directory.
# Left empty for web (the frontend is served separately); the desktop app sets it.
CLIENT_DIR=

# Auth — generate a long random JWT_SECRET for anything non-local.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=12h

# Bootstrap super-admin, seeded once on first boot if absent.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin

# PLC / OPC UA. These are only DEFAULTS the PLC page pre-fills; the live endpoint +
# NodeIds are chosen at runtime (the only swap point). Point at any OPC UA server:
# OpenPLC v4 (native OPC UA server) now, or the physical S7-1500 later
# (opc.tcp://192.168.0.1:4840 with Siemens NodeIds). Set the node defaults to the
# NodeIds of the variables/tags you exposed on that server.
OPCUA_ENDPOINT=opc.tcp://localhost:4840
OPCUA_READ_NODE=ns=1;s=ReadVar
OPCUA_WRITE_NODE=ns=1;s=WriteVar

# Security the client requests when opening a session. A real PLC usually exposes
# ONLY secured endpoints (e.g. Basic256Sha256 Sign/SignAndEncrypt) and NO None
# endpoint — the client must match one it advertises or node-opcua throws
# "End point must exist … securityMode = None".
#   mode:   None | Sign | SignAndEncrypt
#   policy: None | Basic128Rsa15 | Basic256 | Basic256Sha256 | Aes128_Sha256_RsaOaep | Aes256_Sha256_RsaPss
# For a secured connection the PLC must trust our client certificate once (move it
# from the PLC's "rejected" to "trusted" store) and the PLC clock must be correct.
OPCUA_SECURITY_MODE=None
OPCUA_SECURITY_POLICY=None
# Persistent PKI store (own cert + trusted server certs). Empty → pki/ under cwd.
OPCUA_PKI_DIR=
