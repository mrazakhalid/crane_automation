{
  "name": "crane-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Crane Automation — offline desktop app (Electron + SQLite)",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "rebuild": "electron-rebuild -f -m ../backend -o better-sqlite3",
    "bundle": "node scripts/bundle.mjs"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.crane.automation",
    "productName": "Crane Automation",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js"
    ],
    "extraResources": [
      {
        "from": "build-stage/backend",
        "to": "backend"
      },
      {
        "from": "../frontend/dist",
        "to": "frontend"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
