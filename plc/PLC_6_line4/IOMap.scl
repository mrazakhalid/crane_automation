// ============================================================================
//  IOMap  —  PLC_6 (Line 4, crane 7B)  —  real %I/%Q ↔ crane DB mirror
//  FUNCTION (FC), SCL, return Void, no params. Call FIRST in OB1.
//  Addresses from docs/plc/plant-panel-layout.md (PLC_6). Station = tank.number + 1.
// ============================================================================

// ============================ CRANE 7B  (Crane7BData) — DOWNSTREAM ===========
//  Fully wired from the Panel_6 drawing: parking, the transfer pickup (TRVL-4B,
//  fed by 7A), and 7B's three mid-line tank switches all live on input card 1
//  (%I0.x / %I1.x). 7B is downstream — Loading (station 1) is the transfer pickup.
"Crane7BData".ls_mid    := %I0.3;     // LS_Mid_C7B
"Crane7BData".ls_up     := %I0.4;     // LS_Up_C7B
"Crane7BData".ls_dip    := %I0.5;     // LS_Down_C7B
"Crane7BData".estop     := %I0.0;     // E-Stop_SW_C7B
"Crane7BData".auto      := %I0.1;     // Auto_SW_C7B
"Crane7BData".btn_start := %I2.1;     // UP_Pendant_C7B
"Crane7BData".ls_at[0]  := %I1.1;     // PRK-4B-C7B  (Parking — crane 7B home)
"Crane7BData".ls_at[1]  := %I1.3;     // TRVL-4B-C7B (Loading = transfer pickup from 7A)
"Crane7BData".ls_at[8]  := %I0.7;     // 1-4C-C7B  (tank 7 -> station 8)
"Crane7BData".ls_at[9]  := %I1.0;     // 1-5-C7B   (tank 8 -> station 9)
"Crane7BData".ls_at[10] := %I1.2;     // 1-6-C7B   (tank 9 -> station 10)
"Crane7BData".ls_at[11] := %I1.3;     // TRVL-4B-C7B (tank 10 -> station 11)
%Q0.4 := "Crane7BData".mv_up;         // R-Up-1_C7B
%Q0.5 := "Crane7BData".mv_down;       // R-Down-1_C7B
%Q0.6 := "Crane7BData".mv_rev;        // R-East-1_C7B
%Q0.7 := "Crane7BData".mv_fwd;        // R-West-1_C7B
%Q1.0 := "Crane7BData".mv_up OR "Crane7BData".mv_down;    // R-Hoist-1_C7B
%Q1.1 := "Crane7BData".mv_fwd OR "Crane7BData".mv_rev;    // R-Trolley-1_C7B
