// ============================================================================
//  IOMap  —  PLC_5 (Line 5, cranes 8 & 9)  —  real %I/%Q ↔ crane DB mirrors
//  FUNCTION (FC), SCL, return Void, no params. Call FIRST in OB1.
//  Addresses from docs/plc/plant-panel-layout.md (PLC_5). Station = tank.number + 1.
//
//  ROLES (confirmed from the plant picture, East→West):
//    Crane 8 = ENTRY  — loads at LOAD (East end), runs 5-2…5-5, parks P-8.
//    Crane 9 = DOWNSTREAM — picks up at TRVL-5A (West), runs DRY-5A…5-6, parks P-9.
//  Direction is by physical position (see ./POSITION-MAP.md): mv_fwd=West, mv_rev=East.
// ============================================================================

// ============================ CRANE 8  (Crane8Data) — ENTRY crane ============
//  Loads at the LOAD bay (station 1, physical East end). Tanks run West from there;
//  Parking (P-8) sits West of its tanks.
"Crane8Data".ls_mid    := %I4.3;      // LS_Mid_C8
"Crane8Data".ls_up     := %I4.4;      // LS_Up_C8
"Crane8Data".ls_dip    := %I4.5;      // LS_Down_C8
"Crane8Data".estop     := %I4.0;      // E-Stop_SW_C8
"Crane8Data".auto      := %I4.1;      // Auto_SW_C8
"Crane8Data".btn_start := %I5.0;      // UP_Pendant_C8
"Crane8Data".ls_at[0]  := %I5.2;      // PRK-5A_C8  (Parking — station 0)
"Crane8Data".ls_at[1]  := %I6.3;      // LOAD-5A_C8 (Loading — entry bay)  [VERIFY on Panel_5]
"Crane8Data".ls_at[2]  := %I5.3;      // 5-2_C8    (tank 1 -> station 2)
"Crane8Data".ls_at[3]  := %I5.4;      // INS-5A_C8 (tank 2 -> station 3)
"Crane8Data".ls_at[4]  := %I5.5;      // 5-3_C8    (tank 3 -> station 4)
"Crane8Data".ls_at[5]  := %I5.6;      // INS-5B_C8 (tank 4 -> station 5)
"Crane8Data".ls_at[6]  := %I5.7;      // 5-1_C8    (tank 5 -> station 6)
"Crane8Data".ls_at[7]  := %I6.0;      // INS-5C_C8 (tank 6 -> station 7)
"Crane8Data".ls_at[8]  := %I6.1;      // 5-4_C8    (tank 7 -> station 8)
"Crane8Data".ls_at[9]  := %I6.2;      // 5-5_C8    (tank 8 -> station 9)
%Q1.6 := "Crane8Data".mv_up;          // R-Up_C8
%Q1.7 := "Crane8Data".mv_down;        // R-Down_C8
%Q2.0 := "Crane8Data".mv_rev;         // R-East_C8   (East = reverse / lower position)
%Q2.1 := "Crane8Data".mv_fwd;         // R-West_C8   (West = forward / higher position)
%Q2.2 := "Crane8Data".mv_up OR "Crane8Data".mv_down;     // R-Hoist_C8
%Q2.3 := "Crane8Data".mv_fwd OR "Crane8Data".mv_rev;     // R-Trolley_C8

// ============================ CRANE 9  (Crane9Data) — DOWNSTREAM =============
//  No LOAD bay — Loading (station 1) is the transfer pickup at TRVL-5A (West end),
//  the same switch as station 20. Its tanks run East of TRVL-5A; Parking (P-9) is
//  the West-most box.
"Crane9Data".ls_mid    := %I0.3;      // LS_Mid_C9
"Crane9Data".ls_up     := %I0.4;      // LS_Up_C9
"Crane9Data".ls_dip    := %I0.5;      // LS_Down_C9
"Crane9Data".estop     := %I0.0;      // E-Stop_SW_C9
"Crane9Data".auto      := %I0.1;      // Auto_SW_C9
"Crane9Data".btn_start := %I1.0;      // UP_Pendant_C9
"Crane9Data".ls_at[0]  := %I2.7;      // PRK-5B_C9  (Parking — station 0)
"Crane9Data".ls_at[1]  := %I3.1;      // TRVL-5A_C9 (Loading = transfer pickup; same as station 20)
"Crane9Data".ls_at[10] := %I1.6;      // DRY-5A_C9 (tank 9  -> station 10)
"Crane9Data".ls_at[11] := %I1.7;      // 5-12_C9   (tank 10 -> station 11)
"Crane9Data".ls_at[12] := %I2.0;      // INS-5E_C9 (tank 11 -> station 12)
"Crane9Data".ls_at[13] := %I2.1;      // 5-11_C9   (tank 12 -> station 13)
"Crane9Data".ls_at[14] := %I2.2;      // 5-10_C9   (tank 13 -> station 14)
"Crane9Data".ls_at[15] := %I2.3;      // 5-9_C9    (tank 14 -> station 15)
"Crane9Data".ls_at[16] := %I2.4;      // INS-5D_C9 (tank 15 -> station 16)
"Crane9Data".ls_at[17] := %I2.5;      // 5-8_C9    (tank 16 -> station 17)
"Crane9Data".ls_at[18] := %I2.6;      // 5-7_C9    (tank 17 -> station 18)
"Crane9Data".ls_at[19] := %I3.0;      // 5-6_C9    (tank 18 -> station 19)
"Crane9Data".ls_at[20] := %I3.1;      // TRVL-5A_C9 (tank 19 -> station 20; = Loading pickup)
%Q0.4 := "Crane9Data".mv_up;          // R-Up_C9
%Q0.5 := "Crane9Data".mv_down;        // R-Down_C9
%Q0.6 := "Crane9Data".mv_rev;         // R-East_C9
%Q0.7 := "Crane9Data".mv_fwd;         // R-West_C9
%Q1.0 := "Crane9Data".mv_up OR "Crane9Data".mv_down;     // R-Hoist_C9
%Q1.1 := "Crane9Data".mv_fwd OR "Crane9Data".mv_rev;     // R-Trolley_C9
